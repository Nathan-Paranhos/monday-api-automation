{
  "name": "monday-api-automation",
  "version": "1.0.0",
  "description": "API para automatizar criação de estrutura de pastas baseada em demandas do Monday.com",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "dev": "nodemon server.js",
    "dev:debug": "nodemon --inspect server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "echo 'Unit tests not implemented yet'",
    "test:integration": "echo 'Integration tests not implemented yet'",
    "test:webhook": "node tests/webhook-test.js",
    "test:automation": "node tests/automation-test.js",
    "lint": "echo 'Linting not configured yet'",
    "lint:fix": "echo 'Linting not configured yet'",
    "build": "echo 'Build completed - API ready for production'",
    "deploy": "npm run build && npm run start:prod",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop monday-api-prod",
    "pm2:restart": "pm2 restart monday-api-prod",
    "pm2:logs": "pm2 logs monday-api-prod",
    "pm2:monit": "pm2 monit",
    "docker:build": "docker build -t monday-api .",
    "docker:run": "docker run -d --name monday-api-prod -p 3000:3000 --env-file .env.production monday-api",
    "docker:stop": "docker stop monday-api-prod && docker rm monday-api-prod",
    "docker:logs": "docker logs -f monday-api-prod",
    "compose:up": "docker-compose -f docker-compose.prod.yml up -d",
    "compose:down": "docker-compose -f docker-compose.prod.yml down",
    "compose:logs": "docker-compose -f docker-compose.prod.yml logs -f",
    "health-check": "node -e \"require('http').get('http://localhost:3000/health', (res) => { console.log('Status:', res.statusCode); process.exit(res.statusCode === 200 ? 0 : 1) })\"",
    "docs:generate": "echo 'API documentation available at /api-docs'",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "fs-extra": "^11.1.1",
    "graphql-request": "^6.1.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "morgan": "^1.10.0",
    "path": "^0.12.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pm2": "^5.3.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0"
  },
  "keywords": [
    "monday",
    "automation",
    "rpa",
    "api"
  ],
  "author": "Fagron Tech",
  "license": "ISC"
}
