{
  "openapi": "3.0.3",
  "info": {
    "title": "Monday API Automation - v1",
    "description": "API para automatizar a criação de estrutura de pastas baseada em demandas do Monday.com, definindo analistas responsáveis por produto.",
    "version": "1.0.0",
    "contact": {
      "name": "Nathan Silva - Fagron Tech",
      "email": "nathan.silva@fagrontech.com.br"
    }
  },
  "servers": [
    {
      "url": "https://monday-api-automation.onrender.com",
      "description": "Servidor de Produção (Render)"
    },
    {
      "url": "http://localhost:3000",
      "description": "Servidor de Desenvolvimento Local"
    }
  ],
  "tags": [
    {
      "name": "Automation",
      "description": "Endpoints para automação de processos"
    },
    {
      "name": "Monday.com",
      "description": "Endpoints para interação com o Monday.com"
    },
    {
      "name": "System",
      "description": "Endpoints de sistema e saúde da API"
    },
    {
      "name": "Webhooks",
      "description": "Endpoints para recebimento de webhooks"
    },
    {
      "name": "Version",
      "description": "Endpoint para versionamento da API"
    }
  ],
  "paths": {
    "/": {
        "get": {
            "tags": ["System"],
            "summary": "Informações da API",
            "description": "Retorna informações básicas sobre a API.",
            "responses": {
                "200": {
                    "description": "Informações da API"
                }
            }
        }
    },
    "/api/v1/automation/cliente/{id}": {
      "get": {
        "tags": ["Automation"],
        "summary": "Obter informações simplificadas do cliente",
        "description": "Retorna informações simplificadas de um cliente para exibição no frontend.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Informações do cliente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientInfoResponse"
                }
              }
            }
          },
          "404": {
            "description": "Cliente não encontrado"
          }
        }
      }
    },
    "/api/v1/automation": {
        "get": {
            "tags": ["Automation"],
            "summary": "Lista todas as automações",
            "parameters": [
                {
                    "name": "page",
                    "in": "query",
                    "schema": {"type": "integer", "default": 1}
                },
                {
                    "name": "limit",
                    "in": "query",
                    "schema": {"type": "integer", "default": 20}
                },
                {
                    "name": "status",
                    "in": "query",
                    "schema": {"type": "string", "enum": ["processando", "concluido", "erro", "cancelado"]}
                },
                {
                    "name": "clienteId",
                    "in": "query",
                    "schema": {"type": "string"}
                }
            ],
            "responses": {
                "200": {
                    "description": "Lista de automações"
                }
            }
        }
    },
    "/api/v1/automation/process": {
        "post": {
            "tags": ["Automation"],
            "summary": "Processa uma nova automação",
            "requestBody": {
                "required": true,
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "clienteId": {"type": "string"},
                                "produto": {"type": "string"}
                            }
                        }
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "Automação processada"
                }
            }
        }
    },
    "/api/v1/monday/test-connection": {
        "get": {
            "tags": ["Monday.com"],
            "summary": "Testa conexão com Monday.com",
            "responses": {
                "200": {
                    "description": "Conexão bem-sucedida"
                }
            }
        }
    },
    "/api/v1/monday/product/{clienteId}": {
        "get": {
            "tags": ["Monday.com"],
            "summary": "Consulta produto por ID do cliente",
            "parameters": [
                {
                    "name": "clienteId",
                    "in": "path",
                    "required": true,
                    "schema": {"type": "string"}
                }
            ],
            "responses": {
                "200": {
                    "description": "Produto encontrado"
                }
            }
        }
    },
    "/api/v1/webhooks/monday": {
      "post": {
        "tags": ["Webhooks"],
        "summary": "Receber webhook do Monday.com",
        "description": "Endpoint para receber e processar webhooks do Monday.com.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook recebido com sucesso"
          },
          "401": {
            "description": "Assinatura inválida"
          }
        }
      }
    },
    "/api/v1/health": {
        "get": {
            "tags": ["System"],
            "summary": "Verificação de saúde da API",
            "responses": {
                "200": {
                    "description": "API saudável"
                }
            }
        }
    },
    "/api/v1/version": {
      "get": {
        "tags": ["Version"],
        "summary": "Obter versão da API",
        "description": "Retorna a versão da API e dos serviços vinculados.",
        "responses": {
          "200": {
            "description": "Versão da API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClientInfoResponse": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "codigo": {
            "type": "string"
          },
          "data_solicitacao": {
            "type": "string",
            "format": "date"
          },
          "analista_responsavel": {
            "type": "string"
          }
        }
      },
      "VersionResponse": {
        "type": "object",
        "properties": {
          "api": {
            "type": "string"
          },
          "moby": {
            "type": "string"
          },
          "sync": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}