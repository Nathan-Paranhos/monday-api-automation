# Monday.com API Configuration
# Obtenha seu token em: https://monday.com/developers/v2/try-it-yourself
MONDAY_API_TOKEN=your_monday_token_here

# ID do board no Monday.com onde estão as demandas
# Encontre o ID na URL do board: https://company.monday.com/boards/BOARD_ID
MONDAY_BOARD_ID=your_board_id_here

# Base paths (ajuste conforme seu ambiente)
# Para Windows: C:\Users\{User}\OneDrive - Fagron\COM272 - FagronTech - Onboarding\# Backoffice\# BOT Extensão
# Para Linux/Mac: /home/{user}/OneDrive/COM272 - FagronTech - Onboarding/# Backoffice/# BOT Extensão
# Para Render: /tmp
BASE_USER_PATH=C:\Users\{User}\OneDrive - Fagron\COM272 - FagronTech - Onboarding\# Backoffice\# BOT Extensão

# Caminho para o arquivo modelo .vsdx
# Para produção no Render: /tmp/modelo.vsdx
MODEL_FILE_PATH=C:\Users\{User}\OneDrive - Fagron\COM272 - FagronTech - Onboarding\# Backoffice\# BOT Extensão\Modelo - Fluxo de atendimento BOT Numérico.vsdx

# Server Configuration
# Render define automaticamente a PORT
PORT=3000

# Environment (development, production)
NODE_ENV=development